// Zellij config — migrated from tmux (gpakosz/.tmux) setup
// Uses C-a as prefix (tmux mode), matching your tmux C-a prefix

// Mouse support (like tmux: set -g mouse on)
mouse_mode true

// Copy to clipboard (like tmux: tmux_conf_copy_to_os_clipboard=true)
copy_on_select true
copy_command "wl-copy"

// Scrollback (like tmux: history-limit 25000)
scrollback_editor "/usr/bin/vim"
scroll_buffer_size 25000

// Pane frames off — no titles, thin borders, easier mouse resize
pane_frames false

// Set terminal window title to focused tab name (like tmux set-titles)
support_kitty_keyboard_protocol true

// Session serialization — closest thing to tmux-resurrect
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 5000

// Use compact bar (single line at bottom, like tmux status bar)
default_layout "clean"

// Default shell
default_shell "bash"

// Start in normal mode
default_mode "normal"

// Theme matching your tmux dark color scheme
theme "tmux-dark"
themes {
    tmux-dark {
        fg "#e4e4e4"       // your colour_7 (white)
        bg "#2a2a3a"       // soft gray, easier on eyes
        black "#3a3a4a"    // subtle border color
        red "#d70000"      // your colour_16
        green "#5fff00"    // your colour_11
        yellow "#ffff00"   // your colour_5
        blue "#00afff"     // your colour_4
        magenta "#ff00af"  // your colour_10
        cyan "#00afaf"
        white "#e4e4e4"
        orange "#ff5f00"
    }
}

// Keybindings — C-a prefix like tmux
// Strategy: use built-in tmux mode with C-a instead of C-b
keybinds clear-defaults=false {

    // Replace C-b with C-a for tmux mode (your tmux prefix)
    shared_except "locked" {
        unbind "Ctrl b"
        unbind "Ctrl p"
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    // Tmux mode — activated with C-a, acts like tmux prefix
    tmux {
        unbind "Ctrl b"
        bind "Ctrl a" { ToggleTab; SwitchToMode "Normal"; }  // C-a C-a toggles last tab (like tmux)

        // Splits (like tmux: bind | split-window -h)
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }  // tmux default too
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }  // tmux default too

        // Window/Tab navigation (like tmux: bind Space next-window)
        bind "Space" { GoToNextTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }     // C-a Tab = last tab (like C-a C-a in tmux)
        bind "c" { NewTab; SwitchToMode "Normal"; }           // new window

        // Pane navigation (like tmux: bind Tab select-pane -t:.+)
        bind "o" { FocusNextPane; }                            // cycle panes
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }

        // Zoom pane (like tmux: prefix z)
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Scroll/copy mode (like tmux: prefix [)
        bind "[" { SwitchToMode "Scroll"; }

        // Detach (like tmux: prefix d)
        bind "d" { Detach; }

        // Close pane (like tmux: prefix x)
        bind "x" { CloseFocus; SwitchToMode "Normal"; }

        // Rename tab (like tmux: prefix ,)
        bind "," { SwitchToMode "RenameTab"; }

        // Go to tab by number (like tmux: prefix 1-9)
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Session manager (bonus — no tmux equivalent)
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }

    // Alt shortcuts for quick access without prefix (convenience)
    normal {
        unbind "Ctrl t"  // free Ctrl+T for fzf file finder
        bind "Alt |" { NewPane "Right"; }
        bind "Alt -" { NewPane "Down"; }
    }

    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
        bind "Backspace" { TabNameInput 8; }  // 8 = ASCII backspace, deletes char by char
    }

    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
        bind "Backspace" { PaneNameInput 8; }  // 8 = ASCII backspace, deletes char by char
    }

    // Keep all other default modes (scroll, search, resize, etc.)
}
